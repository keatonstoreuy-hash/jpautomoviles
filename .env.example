# Copiá este archivo como ".env.local" para desarrollo local,
# y cargá estas mismas variables en Vercel (Settings → Environment Variables).

# --- Base de datos (Supabase) — activa el catálogo real y el guardado del panel ---
# Se obtienen en Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# ⚠️ SECRETA (no lleva NEXT_PUBLIC). Es la "service_role" de esa misma pantalla.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Acceso al panel /admin ---
# Por defecto el usuario es "jpautomoviles" y la contraseña "jpautos".
# Cambialas acá cuando quieras.
ADMIN_USER=jpautomoviles
ADMIN_PASS=jpautos
# Texto largo y aleatorio para firmar la sesión (poné cualquier cosa difícil de adivinar).
ADMIN_SESSION_SECRET=cambia-esto-por-un-texto-largo-y-secreto

# --- SEO ---
# Dominio final del sitio (para sitemap, canonical y compartir en redes).
NEXT_PUBLIC_SITE_URL=https://jp-automoviles.vercel.app
