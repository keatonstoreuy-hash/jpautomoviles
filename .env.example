# Copiá este archivo como ".env.local" para desarrollo local,
# y cargá estas mismas variables en Vercel (Settings → Environment Variables).
#
# Las obtenés en Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Dominio final del sitio (para SEO, sitemap y compartir en redes).
# Poné el dominio real cuando lo tengas, ej: https://jpautomoviles.com.uy
NEXT_PUBLIC_SITE_URL=https://jp-automoviles.vercel.app
